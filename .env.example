# ========== 本地推理服务（llama.cpp / llama-server）==========
# 口述病史抽取与问答都走这里。不启动也能打开页面：抽取接口返回 503，
# 家系图、风险量化、知识检索等功能照常可用；/chat?demo=1 用预置家系，完全不需要模型。
LLAMA_SERVER_URL=http://127.0.0.1:8080

# ========== MySQL（账户登录与云端同步）==========
# 不配置时按下面的默认值连接；没有数据库也能用，只是没有登录/同步功能。
# 建库与建应用账号的 SQL 见 README「4. 数据库（账户功能）」。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=pedigree_app
MYSQL_PASSWORD=
MYSQL_DATABASE=pedigree

# 说明：会话是服务端 sessions 表里的随机 token（httpOnly cookie），不依赖签名密钥，
# 因此本项目没有 SESSION_SECRET 之类的密钥变量——上面 6 项就是全部环境变量。
